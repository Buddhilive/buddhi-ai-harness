{
  "name": "@buddhilive/dsh-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Buddhilive/buddhi-ai-harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@buddhilive/dsh-api-session-controller",
        "@buddhilive/dsh-api-workspace-controller",
        "@buddhilive/dsh-client-locale",
        "@buddhilive/dsh-client-ui-conversation",
        "@buddhilive/dsh-client-ui-layout",
        "@buddhilive/dsh-client-ui-renderer",
        "@buddhilive/dsh-client-ui-session",
        "@buddhilive/dsh-client-ui-settings",
        "@buddhilive/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@buddhilive/dsh-agent": "workspace:^",
    "@buddhilive/dsh-api-remotes": "workspace:^",
    "@buddhilive/dsh-api-session-controller": "workspace:^",
    "@buddhilive/dsh-api-workspace-controller": "workspace:^",
    "@buddhilive/dsh-attachment": "workspace:^",
    "@buddhilive/dsh-client-locale": "workspace:^",
    "@buddhilive/dsh-client-store": "workspace:^",
    "@buddhilive/dsh-client-ui-approval": "workspace:^",
    "@buddhilive/dsh-client-ui-conversation": "workspace:^",
    "@buddhilive/dsh-client-ui-layout": "workspace:^",
    "@buddhilive/dsh-client-ui-primitives": "workspace:^",
    "@buddhilive/dsh-client-ui-renderer": "workspace:^",
    "@buddhilive/dsh-client-ui-session": "workspace:^",
    "@buddhilive/dsh-client-ui-settings": "workspace:^",
    "@buddhilive/dsh-client-ui-slots": "workspace:^",
    "@buddhilive/dsh-client-ui-workspace": "workspace:^",
    "@buddhilive/dsh-commands": "workspace:^",
    "@buddhilive/dsh-compaction": "workspace:^",
    "@buddhilive/dsh-invariants": "workspace:^",
    "@buddhilive/dsh-llm": "workspace:^",
    "@buddhilive/dsh-llm-retry": "workspace:^",
    "@buddhilive/dsh-session": "workspace:^",
    "@buddhilive/dsh-session-stats": "workspace:^",
    "@buddhilive/dsh-token-meter": "workspace:^",
    "@buddhilive/dsh-tools": "workspace:^",
    "@buddhilive/dsh-util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@buddhilive/dsh-settings": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
