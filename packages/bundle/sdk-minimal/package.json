{
  "name": "@buddhilive/dsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, editor, and JSONL sessions",
  "version": "0.1.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Buddhilive/buddhi-ai-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@buddhilive/dsh-agent-spine-demo": "workspace:^",
    "@buddhilive/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@buddhilive/dsh-fs-local": "workspace:^",
    "@buddhilive/dsh-llm-deepseek": "workspace:^",
    "@buddhilive/dsh-plugin-package-inventory-deepseek": "workspace:^",
    "@buddhilive/dsh-sandbox-local": "workspace:^",
    "@buddhilive/dsh-sandbox-policy": "workspace:^",
    "@buddhilive/dsh-sdk-app": "workspace:^",
    "@buddhilive/dsh-sdk-jsonrpc-server": "workspace:^",
    "@buddhilive/dsh-session-log-deepseek": "workspace:^",
    "@buddhilive/dsh-session-persistence-jsonl": "workspace:^",
    "@buddhilive/dsh-session-projection": "workspace:^",
    "@buddhilive/dsh-subprocess-local": "workspace:^",
    "@buddhilive/dsh-terminal": "workspace:^",
    "@buddhilive/dsh-terminal-bash": "workspace:^",
    "@buddhilive/dsh-tool-bash-persistent": "workspace:^",
    "@buddhilive/dsh-tool-pwsh-persistent": "workspace:^",
    "@buddhilive/dsh-tool-str-replace-editor": "workspace:^"
  },
  "peerDependencies": {
    "@buddhilive/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@buddhilive/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
