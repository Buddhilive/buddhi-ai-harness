    "@buddhilive/dsh-sandbox-policy": "workspace:^",
    "@buddhilive/dsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@buddhilive/dsh-agent": "workspace:^",
    "@buddhilive/dsh-fs": "workspace:^",
    "@buddhilive/dsh-fs-local": "workspace:^",
    "@buddhilive/dsh-fs-observation-policy": "workspace:^",
    "@buddhilive/dsh-fs-sandbox": "workspace:^",
    "@buddhilive/dsh-invariants": "workspace:^",
    "@buddhilive/dsh-llm": "workspace:^",
    "@buddhilive/dsh-sandbox": "workspace:^",
    "@buddhilive/dsh-sandbox-policy": "workspace:^",
    "@buddhilive/dsh-session": "workspace:^",
    "@buddhilive/dsh-system-prompt": "workspace:^",
    "@buddhilive/dsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@buddhilive/dsh-session-projection": "workspace:^"
  }
